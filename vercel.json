{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_RENDER_SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/web-app/static/:path*"
    },
    {
      "source": "/",
      "destination": "/web-app/static/index.html"
    }
  ]
}
